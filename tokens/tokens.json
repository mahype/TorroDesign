{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": "Torro",
  "color": {
    "torro-red":      { "value": "#D50C0C", "type": "color", "description": "Kernfarbe, verbindlich (Vektorwert)" },
    "torro-red-deep": { "value": "#A50A0A", "type": "color", "description": "Verläufe, Hover, Tiefe" },
    "black":          { "value": "#0E0E0F", "type": "color", "description": "Kontur (Bulle), Text" },
    "silver":         { "value": "#C4C3C3", "type": "color", "description": "Wortmarken-Zusatz" },
    "white":          { "value": "#FFFFFF", "type": "color", "description": "Schrift auf Rot" }
  },
  "font": {
    "display": { "value": "Frutiger LT 95 UltraBlack", "type": "fontFamily", "description": "Logo, Headlines" },
    "black":   { "value": "Frutiger LT 75 Black",      "type": "fontFamily" },
    "bold":    { "value": "Frutiger LT 65 Bold",       "type": "fontFamily" },
    "body":    { "value": "Frutiger LT 55 Roman",      "type": "fontFamily" },
    "light":   { "value": "Frutiger LT 45 Light",      "type": "fontFamily" },
    "serif":   { "value": "Minion Pro Regular",        "type": "fontFamily", "description": "Sekundär, Print-Fließtext" }
  },
  "app": {
    "$description": "Designsprache der Apps (app-design.md). Statusfarben: Web-Werte — native Apple-Apps nehmen die Systemfarben, die sich hell/dunkel anpassen.",
    "status": {
      "ok":        { "value": "#28CD41", "type": "color", "description": "Geprüft, verbunden, in Ordnung (Apple: systemGreen)" },
      "attention": { "value": "#FF9500", "type": "color", "description": "Wartet auf den Nutzer, ungeprüft, Abweichung (Apple: systemOrange)" },
      "error":     { "value": "#FF3B30", "type": "color", "description": "Kaputt, abgelehnt (Apple: systemRed — nie Markenrot)" },
      "inactive":  { "value": "#8E8E93", "type": "color", "description": "Nicht eingerichtet, nicht vorhanden (Apple: systemGray)" }
    },
    "surface": {
      "content-max-width": { "value": "720pt", "type": "dimension", "description": "Zentrierte Inhaltsspalte" },
      "content-padding":   { "value": "20pt",  "type": "dimension" },
      "card-gap":          { "value": "10pt",  "type": "dimension", "description": "Auch Spaltenabstand im Zwei-Spalten-Grid" },
      "section-gap":       { "value": "16pt",  "type": "dimension", "description": "12–16 je nach Dichte" },
      "radius-card":       { "value": "12pt",  "type": "dimension", "description": "Kontinuierliche Ecken" },
      "radius-hero":       { "value": "14pt",  "type": "dimension" },
      "radius-code":       { "value": "8pt",   "type": "dimension" },
      "badge-radius-ratio": { "value": 0.24,   "type": "number", "description": "Eckenradius der Kachel-Badges = 0,24 × Kantenlänge" }
    },
    "hero": {
      "watermark-opacity": { "value": 0.09, "type": "number", "description": "Signet weiß, rechts angeschnitten" },
      "border-opacity":    { "value": 0.18, "type": "number", "description": "Randlinie weiß, 1 pt" }
    }
  }
}
